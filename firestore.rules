rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    // Primary authorization using custom claims
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin'
      );
    }

    function isProfessional() {
      return request.auth != null && (
        request.auth.token.professional == true || 
        request.auth.token.role == 'professional'
      );
    }

    function isPendingProfessional() {
      return request.auth != null && (
        request.auth.token.role == 'pending_professional'
      );
    }

    function isClient() {
      return request.auth != null && (
        request.auth.token.role == 'client' ||
        // Fallback for users without claims set yet
        (!('role' in request.auth.token) && !('admin' in request.auth.token) && !('professional' in request.auth.token))
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasVerificationStatus(status) {
      return request.auth != null && request.auth.token.verificationStatus == status;
    }

    function isApprovedProfessional() {
      return isProfessional() && hasVerificationStatus('approved');
    }

    // Users collection - canonical source of truth for user data
    match /users/{userId} {
      allow list: if isAuthenticated() && isAdmin();
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Verifications collection - separate from user data, only verification documents and statuses
    match /verifications/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        // Users can update their own pending verifications
        (isOwner(userId) && resource.data.status == 'pending') ||
        // Admins can update any verification
        isAdmin()
      );
      allow delete: if false; // Verification documents cannot be deleted

      // Verification documents subcollection
      match /documents/{documentId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && (
          (isOwner(userId) && get(/databases/$(database)/documents/verifications/$(userId)).data.status == 'pending') ||
          isAdmin()
        );
        allow delete: if false; // Verification documents cannot be deleted
      }
    }

    // Services collection - base service definitions (admin managed)
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Service categories collection
    match /serviceCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Professional services - services offered by specific professionals
    match /professionalServices/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isProfessional() && request.resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (isProfessional() && resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isClient() || isProfessional() || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Portfolio collection
    match /portfolio/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isProfessional() && request.resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (isProfessional() && resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Content collection - for social media features
    match /content/{contentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isProfessional() && request.resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (isProfessional() && resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (
          isOwner(resource.data.userId) || 
          isAdmin()
        );
      }
    }

    // The Looks collection - curated feed (admin managed)
    match /theLooks/{lookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isClient() && request.resource.data.clientId == request.auth.uid) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.clientId) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Conversations and messaging
    match /conversations/{conversationId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && 
        (request.auth.uid in resource.data.participants || isAdmin());
      allow update, delete: if false; // Conversations cannot be modified after creation

      match /messages/{messageId} {
        allow create: if isAuthenticated() && 
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow read: if isAuthenticated() && 
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow update, delete: if false; // Messages cannot be modified after sending
      }
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Aftercare summaries
    match /aftercareSummaries/{summaryId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.professionalId || 
         request.auth.uid == resource.data.clientId ||
         isAdmin());
      allow create: if isAuthenticated() && (
        (isProfessional() && request.resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      allow update: if isAuthenticated() && 
        ((isProfessional() && request.auth.uid == resource.data.professionalId) || 
         isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Professional notes
    match /professionalNotes/{noteId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isProfessional() && request.auth.uid == resource.data.professionalId) ||
        (isProfessional() && resource.data.visibility == 'shared')
      );
      allow create, update: if isAuthenticated() && (
        (isProfessional() && request.auth.uid == request.resource.data.professionalId) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (isProfessional() && request.auth.uid == resource.data.professionalId) || 
        isAdmin()
      );
    }

    // User activity tracking
    match /userActivity/{activityId} {
      allow read: if isAuthenticated() && (
        activityId.split('_')[0] == request.auth.uid || 
        isAdmin()
      );
      allow create, update: if isAuthenticated() && activityId.split('_')[0] == request.auth.uid;
      allow delete: if isAuthenticated() && isAdmin();
    }

    // User recommendations
    match /userRecommendations/{recommendationId} {
      allow read: if isAuthenticated() && (
        recommendationId.split('_')[0] == request.auth.uid || 
        isAdmin()
      );
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Geo index for location-based queries
    match /geoIndex/{geohash} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isProfessional() && request.resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (isProfessional() && resource.data.professionalId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Legacy collections for backward compatibility
    // These will be gradually phased out as we migrate to the new structure

    // Legacy professionals collection (read-only for migration)
    match /professionals/{professionalId} {
      allow read: if isAuthenticated();
      allow write: if false; // Deprecated - use users collection instead
    }

    // Legacy clients collection (read-only for migration)
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if false; // Deprecated - use users collection instead
    }

    // Legacy admins collection (read-only for migration)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Deprecated - use users collection instead
    }

    // Legacy license collections (read-only for migration)
    match /licenses/{licenseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Deprecated - use verifications collection instead
    }

    // Reference images (admin only)
    match /reference-images/{document=**} {
      allow read: if isAuthenticated() && (isAdmin() || isProfessional());
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
